      "parameters": {
        "command": "=#!/bin/bash\nPORT={{ $json.port }}\n# Find PIDs listening on the port via /proc/net/tcp\n# Port in hex\nHEX_PORT=$(printf '%04X' $PORT)\n\n# Find the inode for the port\nINODE=$(grep -i \":${HEX_PORT} \" /proc/net/tcp | awk '{print $10}')\n\nif [ -z \"$INODE\" ]; then\n    echo \"Nothing listening on port $PORT\"\n    exit 0\nfi\n\n# Find the PID that owns the inode\nfor pid in /proc/[0-9]*/fd/*; do\n    if readlink \"$pid\" 2>/dev/null | grep -q \"socket:\\[${INODE}\\]\"; then\n        PID=$(echo \"$pid\" | cut -d'/' -f3)\n        echo \"Killing PID $PID listening on port $PORT\"\n        kill -9 $PID\n    fi\ndone"
      },
