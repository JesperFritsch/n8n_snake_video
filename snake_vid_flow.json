      "id": "67547a24-e0b6-4fbe-8694-f8267cb0c0bc",
      "name": "Analyze run"
    },
    {
      "parameters": {
        "jsCode": "const parsed = JSON.parse($input.first().json.stdout);\nconst analysis = Array.isArray(parsed) ? parsed[0] : parsed;\n\nconst nrOfSteps = Number($('run_args').first().json.nr_of_steps);\nconst snakeIds = (analysis.snake_ids ?? []).map(String);\nconst fatalStepsObj = analysis.fatal_steps ?? {};\nconst enteredSeparateArea = analysis.entered_separate_area ?? {};\nconst tailVisiblePhases = analysis.tail_visible_phases ?? {};\n\nlet video_end_step;\n\n// Multiple snakes\nif (snakeIds.length > 1) {\n  const fatalSteps = Object.values(fatalStepsObj)\n    .map(Number)\n    .filter(Number.isFinite)\n    .sort((a, b) => a - b);\n\n  if (fatalSteps.length >= snakeIds.length) {\n    // All snakes died -> one snake left after the second highest fatal step\n    video_end_step = fatalSteps[fatalSteps.length - 2] + 50;\n  } else if (fatalSteps.length > 0) {\n    // Last snake never died -> one snake left after the highest fatal step\n    video_end_step = fatalSteps[fatalSteps.length - 1] + 50;\n  } else {\n    // No deaths at all -> fallback\n    video_end_step = Number(analysis.final_step_idx ?? 0);\n  }\n} else {\n  // Single snake\n  const snakeId = snakeIds[0] ?? \"0\";\n  const lastEnteredSeparateAreaStep = Math.max(\n    -Infinity,\n    ...(enteredSeparateArea[snakeId] ?? []).map(Number).filter(Number.isFinite)\n  );\n\n  const phases = tailVisiblePhases[snakeId] ?? [];\n\n  const matchingPhase = phases.find(\n    (p) =>\n      p.tail_visible === true &&\n      Number.isFinite(Number(p.start_step_idx)) &&\n      Number(p.start_step_idx) > lastEnteredSeparateAreaStep\n  );\n\n  if (matchingPhase) {\n    video_end_step = Number(matchingPhase.start_step_idx) + 50;\n  } else {\n    // Fallback if no such phase exists\n    video_end_step = Number(analysis.final_step_idx ?? 0);\n  }\n}\n\nlet video_start_step = video_end_step - nrOfSteps;\nif (video_start_step < 0) {\n  video_start_step = 0;\n  // if start steps is 0 then we should not finish the video at the calculated end step\n  video_end_step = nrOfSteps;\n}\n\n\nreturn [\n  {\n    json: {\n      ...analysis,\n      video_start_step,\n      video_end_step,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
