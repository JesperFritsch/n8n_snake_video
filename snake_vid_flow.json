    {
      "parameters": {
        "command": "=python -m snake_sim.analyze.scripts.run_analyzer {{ $('run_args').item.json.store_dir }}/{{ $('run_args').item.json.run_file }} --dump-json"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
