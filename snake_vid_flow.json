    {
      "parameters": {
        "command": "=ffmpeg -y \\\n  -i {{ $('run_args').item.json.store_dir }}/{{ $('run_args').item.json.video_name }} \\\n  -filter_complex \"[0:v]fps=30,scale=1000:1000:force_original_aspect_ratio=decrease[fg];color=c=black:s=1000x1000:r=30,format=rgba,geq=r='0':g='0':b='0':a='if(lt(X,40)*lt(Y,40),if(lte(hypot(X-40,Y-40),40),255,0),if(gt(X,W-41)*lt(Y,40),if(lte(hypot(X-(W-41),Y-40),40),255,0),if(lt(X,40)*gt(Y,H-41),if(lte(hypot(X-40,Y-(H-41)),40),255,0),if(gt(X,W-41)*gt(Y,H-41),if(lte(hypot(X-(W-41),Y-(H-41)),40),255,0),255))))',pad=1080:1920:(ow-iw)/2:(oh-ih)/2:color=black@0.0,boxblur=luma_radius=0:luma_power=0:chroma_radius=0:chroma_power=0:alpha_radius=35:alpha_power=1[halo];color=c=0x2b2b2b:s=1080x1920:r=30[bg];[bg][halo]overlay=0:0:shortest=1[bg2];[bg2][fg]overlay=(W-w)/2:(H-h)/2:shortest=1,format=yuv420p[v]\" \\\n  -map \"[v]\" \\\n  -an \\\n  -c:v libx264 \\\n  -profile:v high \\\n  -level:v 4.1 \\\n  -crf 18 \\\n  -preset medium \\\n  {{ $('run_args').item.json.store_dir }}/{{ $('run_args').item.json.final_video_name }}"
      },
